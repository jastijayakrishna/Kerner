{
  "version": 3,
  "repository": "owner/repository",
  "deployment": "single-vm",
  "executors": ["external", "kern-gvisor"],
  "image": "sha256:<reviewed-locally-present-node-image-id>",
  "builders": { "executor": "<kern doctor builder digest, executor role>", "verifier": "<kern doctor builder digest, verifier role>" },
  "checks": [
    { "id": "addition", "file": "/operator/checks/addition.json", "sha256": "<kern pin-check output>" },
    { "id": "test-suite", "file": "/operator/checks/test-suite.json", "sha256": "<kern pin-check output>" }
  ],
  "registry": "registry.npmjs.org",
  "permissions": { "test/": ["node:assert"] }
}
