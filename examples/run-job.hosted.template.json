{
  "version": 2,
  "repo": "/absolute/path/to/your/repo",
  "base": "<full-40-hex-base-commit>",
  "contract": "./task.json",
  "image": "docker.io/library/node:22-bookworm-slim@sha256:<digest>",
  "command": ["/usr/local/bin/node", "/opt/agent/agent-entry.js"],
  "mounts": [{ "source": "/absolute/path/to/agent", "target": "/opt/agent" }],
  "env": [],
  "network": false,
  "output": "/absolute/path/to/kern-runs",
  "attempts": 3,
  "promote": false,
  "verifier": {
    "url": "https://verifier.example.com",
    "token_file": "./verifier-token.txt",
    "public_key": "./keys/verifier.pub",
    "operator": "./operator.json"
  }
}
